---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ app_namespace }}
  labels:
    # MongoDB's entrypoint starts as root and drops to uid 999, so enforce baseline;
    # audit against restricted to keep the gap visible.
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/audit: restricted
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: deployer
  namespace: {{ app_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: deployer
  namespace: {{ app_namespace }}
rules:
  # What `kubectl apply -k k8s/nightscout`, `diff`, `rollout status` and `rollout undo` need.
  - apiGroups: [""]
    resources: [configmaps, services, persistentvolumeclaims]
    verbs: [get, list, watch, create, update, patch, delete]
  - apiGroups: ["apps"]
    resources: [deployments, statefulsets]
    verbs: [get, list, watch, create, update, patch, delete]
  - apiGroups: ["apps"]
    resources: [replicasets, controllerrevisions]
    verbs: [get, list, watch]
  - apiGroups: ["networking.k8s.io"]
    resources: [ingresses]
    verbs: [get, list, watch, create, update, patch, delete]
  # Diagnostics for the failure report.
  - apiGroups: [""]
    resources: [pods, pods/log, events]
    verbs: [get, list, watch]
  # The health check reads the copy's API secret; it cannot read or change any other Secret.
  - apiGroups: [""]
    resources: [secrets]
    resourceNames: [nightscout-secrets]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: deployer
  namespace: {{ app_namespace }}
subjects:
  - kind: ServiceAccount
    name: deployer
    namespace: {{ app_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: deployer
---
# SLI exporter (ADR 0008): counts tconnectsync poll outcomes from its log. Reads pods and their
# logs in this namespace only; no Secrets (its API secret arrives as an env var via the kubelet).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ns-exporter
  namespace: {{ app_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ns-exporter
  namespace: {{ app_namespace }}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list]
  - apiGroups: [""]
    resources: [pods/log]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ns-exporter
  namespace: {{ app_namespace }}
subjects:
  - kind: ServiceAccount
    name: ns-exporter
    namespace: {{ app_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: ns-exporter
---
apiVersion: v1
kind: Secret
metadata:
  name: deployer-token
  namespace: {{ app_namespace }}
  annotations:
    kubernetes.io/service-account.name: deployer
type: kubernetes.io/service-account-token
