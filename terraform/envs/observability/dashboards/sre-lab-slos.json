{
  "uid": "sre-lab-slos",
  "title": "sre-lab SLOs",
  "tags": [
    "sre-lab",
    "slo"
  ],
  "description": "Nightscout SLOs (docs/slos.md): budgets, burn rates and SLIs from the Sloth recording rules that also drive the alerts. Managed by Terraform (terraform/envs/observability); UI edits are reverted on apply.",
  "schemaVersion": 42,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/NoelLucasIO/sre-lab/tree/main/docs/runbooks",
      "targetBlank": true,
      "icon": "doc"
    },
    {
      "title": "SLO definitions",
      "type": "link",
      "url": "https://github.com/NoelLucasIO/sre-lab/blob/main/docs/slos.md",
      "targetBlank": true,
      "icon": "info"
    },
    {
      "title": "Alertmanager",
      "type": "link",
      "url": "/alerting/groups?alertmanager=sre-lab-alertmanager",
      "icon": "bolt"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "prometheus",
          "value": "bg14884efuy9sd"
        },
        "includeAll": false,
        "label": "Datasource",
        "name": "ds_prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "/^prometheus$/",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO status (28-day period, k3s copy)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CGM freshness: budget left",
      "description": "Share of the 28-day error budget not yet spent. Below 0 the SLO is missed for the period.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "slo:period_error_budget_remaining:ratio{sloth_slo=\"cgm-freshness\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
